{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esports-tycoon-backend",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ESPORTS_TYCOON_CONTENT_BACKEND": "templated"
  },
  "containers": [
    {
      "class_name": "EsportsTycoonBackend",
      "image": "./Dockerfile",
      "image_build_context": ".",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ESPORTS_TYCOON_BACKEND",
        "class_name": "EsportsTycoonBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EsportsTycoonBackend"]
    }
  ],
  "dev": {
    "port": 8787
  }
}
