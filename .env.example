# Content adapter — which backend renders chirper posts / narration / halftime acks.
#   templated  : deterministic, zero-API. THE DEFAULT — no keys, no network, no cost.
#   vllm       : the gaming-pack LLM client below (opt-in; needs `pip install -e .[vllm]`).
# Leaving this unset keeps the whole slice zero-API.
ESPORTS_TYCOON_CONTENT_BACKEND=templated

# Game runtime LLM — one env-configured, OpenAI-compatible endpoint.
# Dev: your local GPU (vLLM). Prod: a cheap hosted Qwen (DeepInfra/Together/...).
# Swap dev <-> prod by changing these values only; never change game code.
# Only read when ESPORTS_TYCOON_CONTENT_BACKEND=vllm.

GAME_LLM_BASE_URL=http://localhost:8000/v1
GAME_LLM_MODEL=qwen2.5-7b-instruct
GAME_LLM_API_KEY=local

# Cost discipline: right-size the model (7B is plenty for most dialogue), cap
# output length, and cache repeated prompts.
GAME_LLM_MAX_TOKENS=512
GAME_LLM_TEMPERATURE=0.8
GAME_LLM_TIMEOUT=60

# --- Prod example (cheap hosted Qwen) ---
# GAME_LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# GAME_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# GAME_LLM_API_KEY=di-...
