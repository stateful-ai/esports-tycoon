{
  "name": "esports-tycoon-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy --containers-rollout=immediate",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy --containers-rollout=immediate",
    "cf:deploy:dry-run": "wrangler deploy --dry-run",
    "cf:containers": "wrangler containers list",
    "cf:images": "wrangler containers images list",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.5",
    "@cloudflare/workers-types": "4.20260601.1",
    "typescript": "5.9.3",
    "wrangler": "4.95.0"
  }
}
