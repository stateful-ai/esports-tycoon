# Per-slice recap artifacts (runs/<slice_id>/recap.md + feed.snapshot.html) are
# regenerated on every play; they are screenshot/share outputs, not source.
runs/

# vLLM-mode demo preflight bundle (artifacts/vllm_demo/preflight.json + the
# reviewable recap.md/feed.snapshot.html). Re-emitted on every preflight against
# the live endpoint; evidence for the founder's sign-off, not source.
artifacts/
