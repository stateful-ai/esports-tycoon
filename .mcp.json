{
  "mcpServers": {
    "esports-play": {
      "type": "stdio",
      "command": ".venv-win/Scripts/python.exe",
      "args": ["-m", "esports_sim.mcp.play_server"]
    },
    "esports-rosters": {
      "type": "stdio",
      "command": ".venv-win/Scripts/python.exe",
      "args": ["-m", "esports_sim.mcp.roster_server"]
    },
    "esports-maps": {
      "type": "stdio",
      "command": ".venv-win/Scripts/python.exe",
      "args": ["-m", "esports_sim.mcp.map_server"]
    },
    "flywheel": {
      "type": "stdio",
      "command": ".venv-win/Scripts/python.exe",
      "args": ["${AGORA_REPO:-../../agora}/flywheel/mcp_server.py"]
    }
  }
}
